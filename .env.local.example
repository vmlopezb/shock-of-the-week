# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — service_role key (same API settings page, marked "secret").
# Never prefix this with NEXT_PUBLIC_: it bypasses RLS and manages auth.users,
# and must only ever be read server-side (used by admin delete actions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public site URL used to build links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://shockoftheweek.com

# Secret — Resend API key (resend.com dashboard). Used by the challenge
# reminder cron job only; leave unset to keep that feature dormant.
RESEND_API_KEY=your-resend-api-key

# Optional: verified sender address once your domain is set up in Resend.
# Falls back to Resend's shared test address until then.
EMAIL_FROM=Shock of the Week <reminders@shockoftheweek.com>

# Secret — random string shared with Vercel's cron config to stop random
# internet requests from triggering the reminder email job. Generate with
# `openssl rand -hex 32` or similar; any long random string is fine.
CRON_SECRET=your-random-secret-string
